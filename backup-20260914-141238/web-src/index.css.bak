
/* ===== КНОПКА ОПЛАТЫ ПОД ТАЙМЕРОМ ===== */
.pay-button {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  padding: 18px 20px;
  margin-top: 14px;
  background: linear-gradient(135deg, #34C759, #30D158);
  color: #fff;
  text-decoration: none;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(52, 199, 89, 0.35);
  transition: transform 0.15s, box-shadow 0.15s;
}

.pay-button:active {
  transform: scale(0.98);
  box-shadow: 0 4px 12px rgba(52, 199, 89, 0.25);
}

.pay-icon {
  font-size: 28px;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
}

.pay-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.pay-text strong {
  font-size: 16px;
  font-weight: 700;
}

.pay-text small {
  font-size: 12px;
  opacity: 0.85;
}

.pay-arrow {
  font-size: 22px;
  font-weight: 300;
}

@media (prefers-color-scheme: dark) {
  .pay-button {
    background: linear-gradient(135deg, #2DB84E, #28A745);
  }
}

/* ===== ФИНАЛЬНЫЙ АКЦЕНТ: КНОПКА ОПЛАТЫ + КОМПАКТНЫЙ ТАЙМЕР ===== */
.reserve-timer {
  padding: 16px 14px !important;
  margin: 8px 0 4px !important;
}
.reserve-timer-time {
  font-size: 42px !important;
  letter-spacing: 1px !important;
  line-height: 1.1 !important;
}
.reserve-timer-label {
  font-size: 12.5px !important;
}
.reserve-timer-hint {
  font-size: 11.5px !important;
  line-height: 1.4 !important;
}

.pay-button {
  padding: 22px 22px !important;
  margin: 14px 0 18px !important;
  border-radius: 20px !important;
  background: linear-gradient(135deg, #F2A05E 0%, #E8914F 40%, #C86B2E 100%) !important;
  box-shadow: 0 14px 40px rgba(200, 107, 46, 0.45), inset 0 1px 0 rgba(255,255,255,0.25) !important;
  border: 1px solid rgba(255, 255, 255, 0.18);
  animation: payPulse 2.2s ease-in-out infinite;
}
.pay-button:active {
  transform: scale(0.97) !important;
  animation: none;
}
.pay-icon {
  font-size: 36px !important;
  filter: drop-shadow(0 3px 6px rgba(0,0,0,0.25));
}
.pay-text strong {
  font-size: 19px !important;
  font-weight: 800 !important;
  letter-spacing: -0.2px;
}
.pay-text small {
  font-size: 12.5px !important;
  opacity: 0.9 !important;
}
.pay-arrow {
  font-size: 28px !important;
  font-weight: 300;
}
@keyframes payPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 14px 40px rgba(200,107,46,0.45); }
  50% { transform: scale(1.025); box-shadow: 0 18px 54px rgba(200,107,46,0.62); }
}

/* PAY-BUTTON-V2 */
.pay-button {
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
  width: 100% !important;
  padding: 22px !important;
  margin: 14px 0 18px !important;
  border-radius: 20px !important;
  background: linear-gradient(135deg, #F2A05E 0%, #E8914F 40%, #C86B2E 100%) !important;
  color: #fff !important;
  text-decoration: none !important;
  box-shadow: 0 14px 40px rgba(200,107,46,0.45) !important;
  border: 1px solid rgba(255,255,255,0.18);
  animation: payPulse 2.2s ease-in-out infinite;
}
.pay-button:active { transform: scale(0.97) !important; animation: none; }
.pay-icon { font-size: 36px !important; }
.pay-text { flex: 1 !important; display: flex !important; flex-direction: column !important; gap: 2px !important; text-align: left !important; }
.pay-text strong { font-size: 19px !important; font-weight: 800 !important; color: #fff !important; }
.pay-text small { font-size: 12.5px !important; opacity: 0.9 !important; color: #fff !important; }
.pay-arrow { font-size: 28px !important; color: #fff !important; }
@keyframes payPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.025); } }
.reserve-timer { padding: 16px 14px !important; margin: 8px 0 4px !important; }
.reserve-timer-time { font-size: 42px !important; line-height: 1.1 !important; }
.reserve-timer-label { font-size: 12.5px !important; }
.reserve-timer-hint { font-size: 11.5px !important; line-height: 1.4 !important; }
